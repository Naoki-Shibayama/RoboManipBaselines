<?xml version="1.0"?>
<robot name="white_box.urdf">
  <material name="white">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>
  <link name="bottom">
    <visual>
      <origin xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.5 0.5 0.1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.5 0.5 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="edge_nx">
    <visual>
      <geometry>
        <box size="0.05 0.5 0.2"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.5 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="edge_px">
    <visual>
      <geometry>
        <box size="0.05 0.5 0.2"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.5 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="edge_ny">
    <visual>
      <geometry>
        <box size="0.5 0.05 0.2"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.05 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="edge_py">
    <visual>
      <geometry>
        <box size="0.5 0.05 0.2"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.05 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="edge_joint_nx" type="fixed">
    <origin xyz="-0.225 0 0"/>
    <parent link="bottom"/>
    <child link="edge_nx"/>
  </joint>
  <joint name="edge_joint_px" type="fixed">
    <origin xyz="0.225 0 0"/>
    <parent link="bottom"/>
    <child link="edge_px"/>
  </joint>
  <joint name="edge_joint_ny" type="fixed">
    <origin xyz="0 -0.225 0"/>
    <parent link="bottom"/>
    <child link="edge_ny"/>
  </joint>
  <joint name="edge_joint_py" type="fixed">
    <origin xyz="0 0.225 0"/>
    <parent link="bottom"/>
    <child link="edge_py"/>
  </joint>
</robot>
